{
  "calls": [
    {
      "method": "tools/list",
      "params": {},
      "result": {
        "tools": [
          {
            "description": "Build the bounded briefing for the current repository: project, branch, commit, working tree, task goal, previous handoff, and relevant scoped memory.",
            "inputSchema": {
              "properties": {
                "agent_session_key": {
                  "description": "Your own session identifier. Required when more than one session is open in this worktree.",
                  "type": "string"
                },
                "cwd": {
                  "description": "Directory to resolve the repository from",
                  "type": "string"
                },
                "reason": {
                  "enum": [
                    "session_start",
                    "continuation",
                    "refresh"
                  ],
                  "type": "string"
                },
                "session_id": {
                  "description": "Cairn session id, as an alternative to agent_session_key",
                  "type": "string"
                },
                "token_budget": {
                  "description": "Cairn-estimated tokens",
                  "type": "integer"
                }
              },
              "required": [
                "cwd"
              ],
              "type": "object"
            },
            "name": "cairn_context"
          },
          {
            "description": "Search durable memory. Results are ranked scope-first — current task, then branch, then project — with lexical relevance and recency breaking ties within a scope.",
            "inputSchema": {
              "properties": {
                "agent_session_key": {
                  "description": "Your own session identifier, so scope precedence uses your task",
                  "type": "string"
                },
                "cwd": {
                  "description": "Directory to resolve the repository from",
                  "type": "string"
                },
                "limit": {
                  "type": "integer"
                },
                "query": {
                  "type": "string"
                },
                "scope": {
                  "enum": [
                    "project",
                    "branch",
                    "task",
                    "session"
                  ],
                  "type": "string"
                },
                "scope_key": {
                  "type": "string"
                },
                "session_id": {
                  "description": "Cairn session id, as an alternative to agent_session_key",
                  "type": "string"
                },
                "state": {
                  "enum": [
                    "active",
                    "stale",
                    "superseded"
                  ],
                  "type": "string"
                },
                "type": {
                  "enum": [
                    "fact",
                    "decision",
                    "convention",
                    "failure",
                    "procedure"
                  ],
                  "type": "string"
                }
              },
              "required": [
                "cwd"
              ],
              "type": "object"
            },
            "name": "cairn_search"
          },
          {
            "description": "Record durable knowledge, replace it, or forget it. Supporting observations are optional and are never invented.",
            "inputSchema": {
              "properties": {
                "action": {
                  "enum": [
                    "create",
                    "supersede",
                    "forget"
                  ],
                  "type": "string"
                },
                "agent_session_key": {
                  "description": "Your own session identifier. Required when more than one session is open in this worktree.",
                  "type": "string"
                },
                "content": {
                  "type": "string"
                },
                "cwd": {
                  "description": "Directory to resolve the repository from",
                  "type": "string"
                },
                "evidence_observation_ids": {
                  "items": {
                    "type": "string"
                  },
                  "type": "array"
                },
                "local_only": {
                  "type": "boolean"
                },
                "memory_id": {
                  "type": "string"
                },
                "scope": {
                  "enum": [
                    "project",
                    "branch",
                    "task",
                    "session"
                  ],
                  "type": "string"
                },
                "scope_key": {
                  "type": "string"
                },
                "session_id": {
                  "description": "Cairn session id, as an alternative to agent_session_key",
                  "type": "string"
                },
                "type": {
                  "enum": [
                    "fact",
                    "decision",
                    "convention",
                    "failure",
                    "procedure"
                  ],
                  "type": "string"
                }
              },
              "required": [
                "cwd",
                "action"
              ],
              "type": "object"
            },
            "name": "cairn_remember"
          },
          {
            "description": "Inspect or steer the current session. Starting is idempotent per agent session, so two agents in one checkout get two sessions.",
            "inputSchema": {
              "properties": {
                "action": {
                  "enum": [
                    "current",
                    "start",
                    "bind_task",
                    "end"
                  ],
                  "type": "string"
                },
                "agent": {
                  "type": "string"
                },
                "agent_session_key": {
                  "type": "string"
                },
                "cwd": {
                  "description": "Directory to resolve the repository from",
                  "type": "string"
                },
                "status": {
                  "enum": [
                    "completed",
                    "interrupted"
                  ],
                  "type": "string"
                },
                "task_id": {
                  "type": "string"
                }
              },
              "required": [
                "cwd",
                "action"
              ],
              "type": "object"
            },
            "name": "cairn_session"
          },
          {
            "description": "List, read, create or update tasks — title, goal, acceptance criteria and status.",
            "inputSchema": {
              "properties": {
                "acceptance_criteria": {
                  "items": {
                    "type": "string"
                  },
                  "type": "array"
                },
                "action": {
                  "enum": [
                    "list",
                    "get",
                    "create",
                    "update"
                  ],
                  "type": "string"
                },
                "cwd": {
                  "description": "Directory to resolve the repository from",
                  "type": "string"
                },
                "goal": {
                  "type": "string"
                },
                "status": {
                  "enum": [
                    "todo",
                    "in_progress",
                    "done",
                    "blocked"
                  ],
                  "type": "string"
                },
                "task_id": {
                  "type": "string"
                },
                "title": {
                  "type": "string"
                }
              },
              "required": [
                "cwd",
                "action"
              ],
              "type": "object"
            },
            "name": "cairn_task"
          },
          {
            "description": "Read the latest handoff, generate one at a boundary, or attach a bounded note beside the derived record.",
            "inputSchema": {
              "properties": {
                "action": {
                  "enum": [
                    "latest",
                    "generate",
                    "annotate"
                  ],
                  "type": "string"
                },
                "agent_session_key": {
                  "type": "string"
                },
                "cwd": {
                  "description": "Directory to resolve the repository from",
                  "type": "string"
                },
                "note": {
                  "type": "string"
                },
                "session_id": {
                  "type": "string"
                },
                "trigger": {
                  "enum": [
                    "pre_compact",
                    "session_end"
                  ],
                  "type": "string"
                }
              },
              "required": [
                "cwd",
                "action"
              ],
              "type": "object"
            },
            "name": "cairn_handoff"
          }
        ]
      }
