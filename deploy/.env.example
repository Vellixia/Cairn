# Copy to .env in this directory and edit. Never commit the filled-in .env.
#
#   cp deploy/.env.example deploy/.env
#   $EDITOR deploy/.env
#   docker compose -f deploy/docker-compose.yml up -d

# --- PostgreSQL --------------------------------------------------------------
# The database is not published outside the Compose network; only the server
# reaches it. Use a long random password anyway.
POSTGRES_USER=cairn
POSTGRES_PASSWORD=change-me-to-a-long-random-value
POSTGRES_DB=cairn

# --- Cairn images ------------------------------------------------------------
# Pin a released version, or an immutable sha-<short-sha> tag.
CAIRN_VERSION=0.1.0-alpha.2

# --- Ports on the host -------------------------------------------------------
CAIRN_SERVER_PORT=8080
CAIRN_WEB_PORT=3100

# --- Browser origin ----------------------------------------------------------
# The origin the web UI is served from. The server allows credentialed browser
# requests from exactly this origin, so it must match what users type.
CAIRN_WEB_ORIGIN=http://127.0.0.1:3100

# --- Operator account --------------------------------------------------------
# A fresh database has no users, so nobody can sign in. Set these and the server
# creates the account on start.
#
# This is the account's password, not just its initial one: the server
# re-applies it on every start, so rotating it means editing this value and
# restarting. Changing the email defines a second account rather than renaming
# the first. At least 8 characters; generate one rather than choosing it:
#
#   LC_ALL=C tr -dc 'A-Za-z0-9' < /dev/urandom | head -c 32; echo
#
# Leave both blank to seed nothing. Setting only one is a startup error.
CAIRN_ADMIN_EMAIL=
CAIRN_ADMIN_PASSWORD=
CAIRN_ADMIN_DISPLAY_NAME=Admin
