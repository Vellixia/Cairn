# Copy to .env in this directory and edit. Never commit the filled-in .env.
#
#   cp deploy/.env.example deploy/.env
#   $EDITOR deploy/.env
#   docker compose -f deploy/docker-compose.yml up -d

# --- PostgreSQL --------------------------------------------------------------
# The database is not published outside the Compose network; only the server
# reaches it. Use a long random password anyway.
POSTGRES_USER=cairn
POSTGRES_PASSWORD=change-me-to-a-long-random-value
POSTGRES_DB=cairn

# --- Cairn images ------------------------------------------------------------
# Pin a released version, or an immutable sha-<short-sha> tag.
CAIRN_VERSION=0.1.0-alpha.1

# --- Ports on the host -------------------------------------------------------
CAIRN_SERVER_PORT=8080
CAIRN_WEB_PORT=3100

# --- Browser origin ----------------------------------------------------------
# The origin the web UI is served from. The server allows credentialed browser
# requests from exactly this origin, so it must match what users type.
CAIRN_WEB_ORIGIN=http://127.0.0.1:3100
