{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "SessionBindResult",
  "type": "object",
  "required": [
    "bound_at",
    "created",
    "scope",
    "session_id"
  ],
  "properties": {
    "bound_at": {
      "type": "string"
    },
    "created": {
      "type": "boolean"
    },
    "scope": {
      "$ref": "#/definitions/SessionScopeDto"
    },
    "session_id": {
      "type": "string",
      "format": "uuid"
    }
  },
  "additionalProperties": false,
  "definitions": {
    "SessionScopeDto": {
      "description": "Transport scope discriminator. It intentionally contains no lifecycle state because binding and liveness are independent dimensions.",
      "oneOf": [
        {
          "type": "object",
          "required": [
            "mode"
          ],
          "properties": {
            "mode": {
              "type": "string",
              "enum": [
                "local_unbound"
              ]
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "mode",
            "project_id",
            "task_revision_id"
          ],
          "properties": {
            "mode": {
              "type": "string",
              "enum": [
                "project_bound"
              ]
            },
            "project_id": {
              "type": "string",
              "format": "uuid"
            },
            "task_revision_id": {
              "type": "string",
              "format": "uuid"
            }
          },
          "additionalProperties": false
        }
      ]
    }
  }
}