{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "TaskGetResult",
  "type": "object",
  "required": [
    "revision",
    "task"
  ],
  "properties": {
    "revision": {
      "$ref": "#/definitions/TaskRevisionDto"
    },
    "task": {
      "$ref": "#/definitions/TaskDto"
    }
  },
  "additionalProperties": false,
  "definitions": {
    "GoalContractV1": {
      "description": "Validated, normalized, immutable version-one goal contract. Field order is declaration order and therefore canonical JSON order.",
      "type": "object",
      "required": [
        "acceptance_criteria",
        "constraints",
        "excluded_scope",
        "goal",
        "included_scope",
        "schema_version"
      ],
      "properties": {
        "acceptance_criteria": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "constraints": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "excluded_scope": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "goal": {
          "type": "string"
        },
        "included_scope": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "schema_version": {
          "type": "integer",
          "format": "uint16",
          "minimum": 0.0
        }
      }
    },
    "TaskDto": {
      "type": "object",
      "required": [
        "created_at",
        "latest_revision_number",
        "project_id",
        "task_id",
        "title",
        "updated_at"
      ],
      "properties": {
        "created_at": {
          "type": "string"
        },
        "latest_revision_number": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0.0
        },
        "project_id": {
          "type": "string",
          "format": "uuid"
        },
        "task_id": {
          "type": "string",
          "format": "uuid"
        },
        "title": {
          "type": "string"
        },
        "updated_at": {
          "type": "string"
        }
      }
    },
    "TaskRevisionDto": {
      "type": "object",
      "required": [
        "created_at",
        "goal_contract",
        "goal_contract_fingerprint",
        "revision_id",
        "revision_number",
        "task_id"
      ],
      "properties": {
        "created_at": {
          "type": "string"
        },
        "goal_contract": {
          "$ref": "#/definitions/GoalContractV1"
        },
        "goal_contract_fingerprint": {
          "type": "string"
        },
        "parent_revision_id": {
          "type": [
            "string",
            "null"
          ],
          "format": "uuid"
        },
        "revision_id": {
          "type": "string",
          "format": "uuid"
        },
        "revision_number": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0.0
        },
        "task_id": {
          "type": "string",
          "format": "uuid"
        }
      }
    }
  }
}