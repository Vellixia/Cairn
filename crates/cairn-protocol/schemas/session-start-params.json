{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "SessionStartParams",
  "type": "object",
  "required": [
    "agent_instance_id",
    "agent_type"
  ],
  "properties": {
    "agent_instance_id": {
      "type": "string",
      "format": "uuid"
    },
    "agent_pid": {
      "type": [
        "integer",
        "null"
      ],
      "format": "uint32",
      "minimum": 0.0
    },
    "agent_type": {
      "type": "string"
    },
    "path": {
      "type": [
        "string",
        "null"
      ]
    },
    "repository_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "scope": {
      "description": "Omission by a Feature 001 client is the legacy request for `local_unbound`, still subject to the constitutional bootstrap gate.",
      "anyOf": [
        {
          "$ref": "#/definitions/SessionScopeDto"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "definitions": {
    "SessionScopeDto": {
      "description": "Transport scope discriminator. It intentionally contains no lifecycle state because binding and liveness are independent dimensions.",
      "oneOf": [
        {
          "type": "object",
          "required": [
            "mode"
          ],
          "properties": {
            "mode": {
              "type": "string",
              "enum": [
                "local_unbound"
              ]
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "mode",
            "project_id",
            "task_revision_id"
          ],
          "properties": {
            "mode": {
              "type": "string",
              "enum": [
                "project_bound"
              ]
            },
            "project_id": {
              "type": "string",
              "format": "uuid"
            },
            "task_revision_id": {
              "type": "string",
              "format": "uuid"
            }
          },
          "additionalProperties": false
        }
      ]
    }
  }
}