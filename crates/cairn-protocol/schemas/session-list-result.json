{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "SessionListResult",
  "type": "object",
  "required": [
    "sessions"
  ],
  "properties": {
    "sessions": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/SessionSummaryDto"
      }
    }
  },
  "definitions": {
    "SessionScopeDto": {
      "description": "Transport scope discriminator. It intentionally contains no lifecycle state because binding and liveness are independent dimensions.",
      "oneOf": [
        {
          "type": "object",
          "required": [
            "mode"
          ],
          "properties": {
            "mode": {
              "type": "string",
              "enum": [
                "local_unbound"
              ]
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "mode",
            "project_id",
            "task_revision_id"
          ],
          "properties": {
            "mode": {
              "type": "string",
              "enum": [
                "project_bound"
              ]
            },
            "project_id": {
              "type": "string",
              "format": "uuid"
            },
            "task_revision_id": {
              "type": "string",
              "format": "uuid"
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "SessionState": {
      "type": "string",
      "enum": [
        "active",
        "recovering",
        "stopped",
        "interrupted"
      ]
    },
    "SessionSummaryDto": {
      "type": "object",
      "required": [
        "agent_instance_id",
        "agent_type",
        "scope",
        "session_id",
        "started_at",
        "state"
      ],
      "properties": {
        "agent_instance_id": {
          "type": "string",
          "format": "uuid"
        },
        "agent_type": {
          "type": "string"
        },
        "scope": {
          "$ref": "#/definitions/SessionScopeDto"
        },
        "session_id": {
          "type": "string",
          "format": "uuid"
        },
        "started_at": {
          "type": "string"
        },
        "state": {
          "$ref": "#/definitions/SessionState"
        }
      }
    }
  }
}